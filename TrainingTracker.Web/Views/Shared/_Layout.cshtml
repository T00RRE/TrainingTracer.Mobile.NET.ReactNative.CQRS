<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TrainingTracker</title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">

    <style>
        body { display: flex; min-height: 100vh; flex-direction: column; background-color: #f5f5f5; }
        main { flex: 1 0 auto; padding: 20px 0; }
        .nav-wrapper { padding-left: 20px; padding-right: 20px; }
        .brand-logo { font-weight: 300; }
    </style>
</head>
<body>
    <nav class="light-blue darken-3" role="navigation">
        <div class="nav-wrapper container">
            <a href="/" class="brand-logo"><i class="material-icons left">fitness_center</i>TrainingTracker</a>
            <ul class="right hide-on-med-and-down">
                <li><a href="/">Sklep (Plany)</a></li>
                <li><a href="/Trainer">Panel Trenera</a></li>
            </ul>
        </div>
    </nav>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="page-footer orange">
        <div class="footer-copyright">
            <div class="container">
                © 2026 TrainingTracker
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>

    <script>
        // Inicjalizacja komponentów Materialize
        $(document).ready(function(){
            M.AutoInit();
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>